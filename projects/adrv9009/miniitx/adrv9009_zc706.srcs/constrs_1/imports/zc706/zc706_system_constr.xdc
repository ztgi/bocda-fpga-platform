# Define SPI clock
create_clock -period 40.000 -name spi0_clk [get_pins -hier */EMIOSPI0SCLKO]
create_clock -period 40.000 -name spi1_clk [get_pins -hier */EMIOSPI1SCLKO]


set_property PULLUP true [get_ports ad9528_reset_b]
set_property PULLUP true [get_ports adrv9009_reset_b]









set_property PACKAGE_PIN AG27 [get_ports iic_sda]



























set_property PACKAGE_PIN AA14 [get_ports clk_2_out]
set_property IOSTANDARD LVCMOS33 [get_ports clk_2_out]




























